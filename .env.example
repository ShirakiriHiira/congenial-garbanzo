TELEGRAM_BOT_TOKEN=

# Required: comma-separated positive Telegram user IDs (no public access).
ALLOWED_TELEGRAM_USER_IDS=

# Only TELEGRAM_BOT_TOKEN is loaded from .env by the local binary.
# Export the other variables before running locally; Compose reads this file.
DATABASE_PATH=./data/remind.db
APP_TIMEZONE=Asia/Taipei
REMINDER_SCAN_INTERVAL=30s
REMINDER_CATCHUP_WINDOW=24h
WEBAPP_AUTH_MAX_AGE=24h
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Optional: proxy for Telegram API traffic. Accepts http, https, socks5, socks5h.
# Leave empty to honor HTTP_PROXY/HTTPS_PROXY/NO_PROXY. Must be exported locally.
# TELEGRAM_API_PROXY=http://127.0.0.1:7890
# Optional: public https origin of the Mini App. When set, /start installs a
# Mini App menu button in the user's private chat. Must be exported locally.
# MINIAPP_PUBLIC_URL=https://remind.example.com

# Compose mounts this entire named volume at /data; change for recovery.

# Compose-only loopback port for the same-origin Mini App reverse proxy.
MINIAPP_HTTP_PORT=8081
REMIND_DATA_VOLUME=sim-reminder-data

# Optional: override the prebuilt images pulled from GHCR (CI builds them).
# REMIND_APP_IMAGE=ghcr.io/shirakirihiira/telegram-bot-remind-app:main
# REMIND_WEB_IMAGE=ghcr.io/shirakirihiira/telegram-bot-remind-web:main
