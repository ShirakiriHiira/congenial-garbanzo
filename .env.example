TELEGRAM_BOT_TOKEN=

# Required: comma-separated positive Telegram user IDs (no public access).
ALLOWED_TELEGRAM_USER_IDS=

# Only TELEGRAM_BOT_TOKEN is loaded from .env by the local binary.
# Export the other variables before running locally; Compose reads this file.
DATABASE_PATH=./data/remind.db
APP_TIMEZONE=Asia/Taipei
REMINDER_SCAN_INTERVAL=30s
REMINDER_CATCHUP_WINDOW=24h
WEBAPP_AUTH_MAX_AGE=5m
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Compose mounts this entire named volume at /data; change for recovery.
REMIND_DATA_VOLUME=sim-reminder-data
