server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org 'sha256-__THEME_SHA256__'; style-src 'self'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.cdn-telegram.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Static responses override Cache-Control, which drops inherited add_header
    # directives, so each of these locations repeats the security headers.
    location = /app {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org 'sha256-__THEME_SHA256__'; style-src 'self'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.cdn-telegram.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        return 301 /app/;
    }

    location /app/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org 'sha256-__THEME_SHA256__'; style-src 'self'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.cdn-telegram.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri =404;
    }

    location = /app/nginx.conf { return 404; }

    location = /app/index.html {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org 'sha256-__THEME_SHA256__'; style-src 'self'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.cdn-telegram.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri =404;
    }

    location /app/ {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org 'sha256-__THEME_SHA256__'; style-src 'self'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.cdn-telegram.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri $uri/ /app/index.html;
    }

    location /api/v1/ {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location = /healthz { proxy_pass http://app:8080; }
    location = /readyz { proxy_pass http://app:8080; }
    location / { return 404; }
}
